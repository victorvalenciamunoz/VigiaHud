<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VigiaHud.App.WatchPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource HudBackground}">

    <ContentPage.Resources>
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="FontFamily" Value="ChakraPetch" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinimumHeightRequest" Value="32" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{DynamicResource HudGuide}" />
            <Setter Property="BorderColor" Value="{DynamicResource HudGuide}" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="{DynamicResource HudBackground}" />
            <Setter Property="Stroke" Value="{DynamicResource HudTextDim}" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="8" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="ChakraPetchBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="1" />
            <Setter Property="TextColor" Value="{DynamicResource HudTextSoft}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,44,16,16" RowSpacing="12">

        <!-- Header in the family's look: the name, and the version. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Text="VIGÍAHUD" FontFamily="ChakraPetchBold" FontSize="18" CharacterSpacing="2"
                   TextColor="{DynamicResource HudGuide}" VerticalOptions="Center" />
            <Label Grid.Column="1" x:Name="Version" FontFamily="ChakraPetch" FontSize="11" CharacterSpacing="1"
                   TextColor="{DynamicResource HudTextMuted}" VerticalOptions="Center" />
        </Grid>

        <!-- The watch: is it running, and the button to start or stop it. The service is the platform's; the page only asks. -->
        <Border Grid.Row="1" Style="{StaticResource Panel}">
            <VerticalStackLayout Spacing="8">
                <Label Text="VIGILANCIA" Style="{StaticResource PanelTitle}" />
                <Label x:Name="Status" Text="Parada." FontFamily="ChakraPetchBold" FontSize="20" CharacterSpacing="1"
                       TextColor="{DynamicResource HudTextMuted}" />
                <Label x:Name="Detail" Text="Pulsa INICIAR para dejar el servicio vigilando con la pantalla apagada."
                       FontFamily="OpenSansRegular" FontSize="12" TextColor="{DynamicResource HudTextMuted}" />
                <Button x:Name="Toggle" Text="INICIAR" Style="{StaticResource Chip}" Clicked="OnToggleClicked"
                        HorizontalOptions="Start" Margin="0,6,0,0" />
            </VerticalStackLayout>
        </Border>

        <!-- The tail of the log (DECISIONS 006): the judge, readable on the phone itself. Errors in red. -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" VerticalOptions="Start">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="REGISTRO" Style="{StaticResource PanelTitle}" />
                    <Button Grid.Column="1" Text="ACTUALIZAR" Style="{StaticResource Chip}" Clicked="OnRefreshLogClicked" />
                </Grid>
                <VerticalStackLayout x:Name="LogLines" Spacing="3" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
